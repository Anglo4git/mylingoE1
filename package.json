{
  "name": "mylingo-site",
  "version": "1.0.0",
  "release": "v118",
  "private": true,
  "description": "Test tooling for the Mylingo static site (site/ is the actual deployable app \u2014 no build step for it).",
  "scripts": {
    "release:verify-identity": "python3 scripts/verify_release_identity.py",
    "lint": "node scripts/lint.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js --project=chromium",
    "test:e2e:core": "playwright test tests/e2e/quiz-flow.spec.js",
    "audit": "python3 content_qa.py --input master_source.csv --out-dir content_qa",
    "release:build": "bash ci/release_gate.sh",
    "release:gate": "python3 build.py release-gate --input master_source.csv --site dist-release --report dist-release/RELEASE_GATE_REPORT.md",
    "test:python": "python3 -m unittest discover -s tests/unit -p 'test_*.py' -v",
    "placement:coverage": "node scripts/placement_coverage_report.mjs",
    "coverage": "node scripts/coverage_gate.mjs",
    "typecheck": "node scripts/typecheck_contract.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
